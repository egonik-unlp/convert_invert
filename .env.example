# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5455/convert-invert
MIGRATIONS_DIRECTORY=migrations

# --- API ------------------------------------------------------------------
# Static API key — required. The API rejects all requests without a matching
# `X-API-Key` header. Generate one with `openssl rand -hex 32`.
API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Comma-separated allowed origins for CORS (no spaces). Only matters for split-origin
# setups; the same-origin proxy path (blank VITE_API_BASE_URL) needs no CORS. Default
# covers the compose frontend (:5173) and the native Vite dev server (:3000).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

SERVER_BIND=0.0.0.0:3124

# --- Worker tuning --------------------------------------------------------
WORKER_COUNT=1
WORKER_ACCOUNT_MODE=same
WORKER_USERNAME_PREFIX=your-soulseek-username
WORKER_PORT_BASE=41000
WORKER_RUN_ID_PREFIX=web-trigger
SEARCH_CONCURRENCY=1
DOWNLOAD_CONCURRENCY=1
SEARCH_TIMEOUT_SECS=20
SEARCH_EMPTY_RESULT_CUTOFF=8
MAX_CANDIDATES_PER_TRACK=8
MAX_DOWNLOAD_ATTEMPTS_PER_TRACK=4
CANDIDATE_COLLECTION_SECS=20
MAX_SEARCH_PASSES_PER_TRACK=2
MAX_REQUESTS_PER_TRACK=8

# Anti-ban pacing. These add deliberate delays to avoid hammering Soulseek peers/servers
# and getting rate-limited or banned. Set any to 0 to disable that behavior.
#   RETRY_BACKOFF_MS  base backoff (full jitter -> [base, 2*base)) before each retry
#   SEARCH_PACING_MS  base delay (jittered) before issuing each search
#   PEER_COOLDOWN_SECS seconds a peer is skipped for new attempts after it fails
RETRY_BACKOFF_MS=1000
SEARCH_PACING_MS=500
PEER_COOLDOWN_SECS=120

# Download inactivity timeouts. An inactive transfer holds a scarce concurrency slot and keeps
# a chunk from finishing, clogging the pipeline; these abort it so a fresh candidate/peer can
# take the slot (the failed peer is then cooled down via PEER_COOLDOWN_SECS). Set any to 0 to
# disable that specific timeout.
#   DOWNLOAD_QUEUED_TIMEOUT_SECS  max time parked in the remote queue (not transferring)
#   DOWNLOAD_STALL_TIMEOUT_SECS   max time transferring with zero byte progress
#   DOWNLOAD_HARD_TIMEOUT_SECS    absolute ceiling for one attempt (keep generous for big files)
DOWNLOAD_QUEUED_TIMEOUT_SECS=45
DOWNLOAD_STALL_TIMEOUT_SECS=30
DOWNLOAD_HARD_TIMEOUT_SECS=180

# Increase concurrency/counts gradually only after a stable low-volume run.

# --- Sharing ---------------------------------------------------------------
# The pinned Soulseek library does not serve real shared files. Use `external`
# only when another Soulseek-compatible client is sharing SHARE_PATH.
SHARE_MODE=external
SHARE_PATH=/downloads
SHARE_LISTEN_PORT=41032
SHARE_RESCAN_INTERVAL_SECS=60

# --- Soulseek -------------------------------------------------------------
USER_NAME=your-soulseek-username
USER_PASSWORD=your-soulseek-password
LISTEN_PORT=41000

# --- Spotify --------------------------------------------------------------
CLIENT_ID=your-spotify-client-id
CLIENT_SECRET=your-spotify-client-secret

# --- Infra ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379
JAEGER_URL=http://localhost:16686
OTLP_ENDPOINT=http://localhost:4317
DOWNLOAD_PATH=./downloads
RUN_ID=local
LOG_LEVEL=info
